+"""CLI for slotted CBOR framing."""
+
 from __future__ import annotations
 
+import argparse
 import sys
+from pathlib import Path
+
+from slotted_cbor.frame import FramingError, decode_stream, encode_stream, stream_decode_lines
+
+
+def _fail(exc: FramingError) -> None:
+    print(f"SLCB:{exc.code}:{exc}", file=sys.stderr)
+    raise SystemExit(exc.code)
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(prog="slotted_cbor")
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    enc = sub.add_parser("encode")
+    enc.add_argument("--manifest", required=True)
+    enc.add_argument("--output", required=True)
+    dec = sub.add_parser("decode")
+    dec.add_argument("--input", required=True)
+    dec.add_argument("--output-dir", required=True)
+    st = sub.add_parser("stream-decode")
+    st.add_argument("--input", required=True)
+    args = ap.parse_args()
+    try:
+        if args.cmd == "encode":
+            encode_stream(Path(args.manifest), Path(args.output))
+        elif args.cmd == "decode":
+            decode_stream(Path(args.input), Path(args.output_dir))
+        else:
+            for line in stream_decode_lines(Path(args.input)):
+                print(line)
+    except FramingError as err:
+        _fail(err)
+
 
